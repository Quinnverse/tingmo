[Unit]
Description=Tingmo TTS Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/tingmo/server
ExecStart=/opt/tingmo/server/run.sh
Restart=always
RestartSec=3
User=root
Environment=ALLOWED_ORIGINS=https://quinnverse.github.io
Environment=PORT=8443
Environment=SSL_KEYFILE=/etc/tingmo/key.pem
Environment=SSL_CERTFILE=/etc/tingmo/cert.pem

[Install]
WantedBy=multi-user.target
